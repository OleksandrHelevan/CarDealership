<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <Styles>
  <Style ss:ID="Header"><Font ss:Bold="1"/><Interior ss:Color="#D9E1F2" ss:Pattern="Solid"/></Style>
  <Style ss:ID="Th"><Font ss:Bold="1"/><Interior ss:Color="#F2F2F2" ss:Pattern="Solid"/></Style>
 </Styles>

 <Worksheet ss:Name="keys">
  <Table>
   <Row ss:StyleID="Header"><Cell ss:MergeAcross="2"><Data ss:Type="String">keys</Data></Cell></Row>
   <Row ss:StyleID="Th">
    <Cell><Data ss:Type="String">Поле</Data></Cell>
    <Cell><Data ss:Type="String">Тип</Data></Cell>
    <Cell><Data ss:Type="String">Опис</Data></Cell>
   </Row>
   <Row><Cell><Data ss:Type="String">id</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">PK, унікальний ідентифікатор користувача (Primary Key)</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">login</Data></Cell><Cell><Data ss:Type="String">VARCHAR(100)</Data></Cell><Cell><Data ss:Type="String">Логін користувача</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">email</Data></Cell><Cell><Data ss:Type="String">VARCHAR(255)</Data></Cell><Cell><Data ss:Type="String">Електронна пошта</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">password</Data></Cell><Cell><Data ss:Type="String">VARCHAR(100)</Data></Cell><Cell><Data ss:Type="String">Хеш пароля</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">access_right</Data></Cell><Cell><Data ss:Type="String">ENUM</Data></Cell><Cell><Data ss:Type="String">Права доступу користувача</Data></Cell></Row>
  </Table>
 </Worksheet>

 <Worksheet ss:Name="clients">
  <Table>
   <Row ss:StyleID="Header"><Cell ss:MergeAcross="2"><Data ss:Type="String">clients</Data></Cell></Row>
   <Row ss:StyleID="Th"><Cell><Data ss:Type="String">Поле</Data></Cell><Cell><Data ss:Type="String">Тип</Data></Cell><Cell><Data ss:Type="String">Опис</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">id</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">PK, унікальний ідентифікатор клієнта</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">user_id</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">FK, посилання на keys.id (обліковий запис)</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">passport_data_id</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">FK, посилання на passport_data.id</Data></Cell></Row>
  </Table>
 </Worksheet>

 <Worksheet ss:Name="passport_data">
  <Table>
   <Row ss:StyleID="Header"><Cell ss:MergeAcross="2"><Data ss:Type="String">passport_data</Data></Cell></Row>
   <Row ss:StyleID="Th"><Cell><Data ss:Type="String">Поле</Data></Cell><Cell><Data ss:Type="String">Тип</Data></Cell><Cell><Data ss:Type="String">Опис</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">id</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">PK</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">first_name</Data></Cell><Cell><Data ss:Type="String">VARCHAR(100)</Data></Cell><Cell><Data ss:Type="String">Ім’я</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">last_name</Data></Cell><Cell><Data ss:Type="String">VARCHAR(100)</Data></Cell><Cell><Data ss:Type="String">Прізвище</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">passport_number</Data></Cell><Cell><Data ss:Type="String">VARCHAR(50)</Data></Cell><Cell><Data ss:Type="String">Номер паспорта</Data></Cell></Row>
  </Table>
 </Worksheet>

 <Worksheet ss:Name="requests">
  <Table>
   <Row ss:StyleID="Header"><Cell ss:MergeAcross="2"><Data ss:Type="String">requests</Data></Cell></Row>
   <Row ss:StyleID="Th"><Cell><Data ss:Type="String">Поле</Data></Cell><Cell><Data ss:Type="String">Тип</Data></Cell><Cell><Data ss:Type="String">Опис</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">id</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">PK</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">user_id</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">FK, посилання на keys.id</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">status</Data></Cell><Cell><Data ss:Type="String">ENUM</Data></Cell><Cell><Data ss:Type="String">Статус запиту доступу</Data></Cell></Row>
  </Table>
 </Worksheet>

 <Worksheet ss:Name="engines">
  <Table>
   <Row ss:StyleID="Header"><Cell ss:MergeAcross="2"><Data ss:Type="String">engines</Data></Cell></Row>
   <Row ss:StyleID="Th"><Cell><Data ss:Type="String">Поле</Data></Cell><Cell><Data ss:Type="String">Тип</Data></Cell><Cell><Data ss:Type="String">Опис</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">id</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">PK</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">engine_type</Data></Cell><Cell><Data ss:Type="String">ENUM</Data></Cell><Cell><Data ss:Type="String">Тип двигуна</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">power</Data></Cell><Cell><Data ss:Type="String">DOUBLE</Data></Cell><Cell><Data ss:Type="String">Потужність</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">fuel_type</Data></Cell><Cell><Data ss:Type="String">ENUM, NULL</Data></Cell><Cell><Data ss:Type="String">Тип пального (за наявності)</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">fuel_consumption</Data></Cell><Cell><Data ss:Type="String">FLOAT, NULL</Data></Cell><Cell><Data ss:Type="String">Витрата пального</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">battery_capacity</Data></Cell><Cell><Data ss:Type="String">DOUBLE, NULL</Data></Cell><Cell><Data ss:Type="String">Ємність батареї</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">range</Data></Cell><Cell><Data ss:Type="String">INT, NULL</Data></Cell><Cell><Data ss:Type="String">Запас ходу</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">motor_type</Data></Cell><Cell><Data ss:Type="String">ENUM, NULL</Data></Cell><Cell><Data ss:Type="String">Тип електромотора</Data></Cell></Row>
  </Table>
 </Worksheet>

 <Worksheet ss:Name="cars">
  <Table>
   <Row ss:StyleID="Header"><Cell ss:MergeAcross="2"><Data ss:Type="String">cars</Data></Cell></Row>
   <Row ss:StyleID="Th"><Cell><Data ss:Type="String">Поле</Data></Cell><Cell><Data ss:Type="String">Тип</Data></Cell><Cell><Data ss:Type="String">Опис</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">id</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">PK</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">car_type</Data></Cell><Cell><Data ss:Type="String">ENUM</Data></Cell><Cell><Data ss:Type="String">Тип авто</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">brand</Data></Cell><Cell><Data ss:Type="String">VARCHAR(100)</Data></Cell><Cell><Data ss:Type="String">Марка</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">model_name</Data></Cell><Cell><Data ss:Type="String">VARCHAR(100)</Data></Cell><Cell><Data ss:Type="String">Модель</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">engine_id</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">FK, посилання на engines.id</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">color</Data></Cell><Cell><Data ss:Type="String">ENUM</Data></Cell><Cell><Data ss:Type="String">Колір</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">mileage</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">Пробіг</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">price</Data></Cell><Cell><Data ss:Type="String">DECIMAL(18,2)</Data></Cell><Cell><Data ss:Type="String">Ціна</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">weight</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">Вага</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">drive_type</Data></Cell><Cell><Data ss:Type="String">ENUM</Data></Cell><Cell><Data ss:Type="String">Привід</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">transmission</Data></Cell><Cell><Data ss:Type="String">ENUM</Data></Cell><Cell><Data ss:Type="String">Коробка передач</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">year</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">Рік випуску</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">number_of_doors</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">Кількість дверей</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">body_type</Data></Cell><Cell><Data ss:Type="String">ENUM</Data></Cell><Cell><Data ss:Type="String">Тип кузова</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">on_sale</Data></Cell><Cell><Data ss:Type="String">BOOLEAN</Data></Cell><Cell><Data ss:Type="String">Позначка «виставлено на продаж»</Data></Cell></Row>
  </Table>
 </Worksheet>

 <Worksheet ss:Name="products">
  <Table>
   <Row ss:StyleID="Header"><Cell ss:MergeAcross="2"><Data ss:Type="String">products</Data></Cell></Row>
   <Row ss:StyleID="Th"><Cell><Data ss:Type="String">Поле</Data></Cell><Cell><Data ss:Type="String">Тип</Data></Cell><Cell><Data ss:Type="String">Опис</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">id</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">PK</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">number</Data></Cell><Cell><Data ss:Type="String">VARCHAR</Data></Cell><Cell><Data ss:Type="String">Номер/код товару</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">country_of_origin</Data></Cell><Cell><Data ss:Type="String">VARCHAR</Data></Cell><Cell><Data ss:Type="String">Країна походження</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">in_stock</Data></Cell><Cell><Data ss:Type="String">BOOLEAN</Data></Cell><Cell><Data ss:Type="String">Є в наявності</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">amount</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">Кількість на складі</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">available_from</Data></Cell><Cell><Data ss:Type="String">TIMESTAMP, NULL</Data></Cell><Cell><Data ss:Type="String">Коли очікується в наявності</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">car_id</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">FK, посилання на cars.id</Data></Cell></Row>
  </Table>
 </Worksheet>

 <Worksheet ss:Name="orders">
  <Table>
   <Row ss:StyleID="Header"><Cell ss:MergeAcross="2"><Data ss:Type="String">orders</Data></Cell></Row>
   <Row ss:StyleID="Th"><Cell><Data ss:Type="String">Поле</Data></Cell><Cell><Data ss:Type="String">Тип</Data></Cell><Cell><Data ss:Type="String">Опис</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">id</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">PK</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">client_id</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">FK, посилання на clients.id</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">product_id</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">FK, посилання на products.id</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">order_date</Data></Cell><Cell><Data ss:Type="String">TIMESTAMPTZ</Data></Cell><Cell><Data ss:Type="String">Дата і час оформлення</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">payment_type</Data></Cell><Cell><Data ss:Type="String">ENUM</Data></Cell><Cell><Data ss:Type="String">Тип оплати</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">delivery</Data></Cell><Cell><Data ss:Type="String">BOOLEAN</Data></Cell><Cell><Data ss:Type="String">Потрібна доставка</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">address</Data></Cell><Cell><Data ss:Type="String">VARCHAR(400), NULL</Data></Cell><Cell><Data ss:Type="String">Адреса доставки</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">phone_number</Data></Cell><Cell><Data ss:Type="String">VARCHAR(32), NULL</Data></Cell><Cell><Data ss:Type="String">Телефон для зв’язку</Data></Cell></Row>
  </Table>
 </Worksheet>

 <Worksheet ss:Name="order_reviews">
  <Table>
   <Row ss:StyleID="Header"><Cell ss:MergeAcross="2"><Data ss:Type="String">order_reviews</Data></Cell></Row>
   <Row ss:StyleID="Th"><Cell><Data ss:Type="String">Поле</Data></Cell><Cell><Data ss:Type="String">Тип</Data></Cell><Cell><Data ss:Type="String">Опис</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">id</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">PK</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">order_id</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">FK, посилання на orders.id</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">status</Data></Cell><Cell><Data ss:Type="String">ENUM</Data></Cell><Cell><Data ss:Type="String">Статус перевірки</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">message</Data></Cell><Cell><Data ss:Type="String">VARCHAR(500), NULL</Data></Cell><Cell><Data ss:Type="String">Причина/коментар</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">requires_delivery_address</Data></Cell><Cell><Data ss:Type="String">BOOLEAN</Data></Cell><Cell><Data ss:Type="String">Потрібна адреса доставки</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">requires_card_number</Data></Cell><Cell><Data ss:Type="String">BOOLEAN</Data></Cell><Cell><Data ss:Type="String">Потрібен номер картки</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">card_number</Data></Cell><Cell><Data ss:Type="String">VARCHAR(32), NULL</Data></Cell><Cell><Data ss:Type="String">Номер картки (за потреби)</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">created_at</Data></Cell><Cell><Data ss:Type="String">TIMESTAMPTZ</Data></Cell><Cell><Data ss:Type="String">Створено</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">updated_at</Data></Cell><Cell><Data ss:Type="String">TIMESTAMPTZ, NULL</Data></Cell><Cell><Data ss:Type="String">Оновлено</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">approved_by_user_id</Data></Cell><Cell><Data ss:Type="String">INT, NULL</Data></Cell><Cell><Data ss:Type="String">FK, посилання на keys.id (хто схвалив)</Data></Cell></Row>
  </Table>
 </Worksheet>

 <Worksheet ss:Name="payment_history">
  <Table>
   <Row ss:StyleID="Header"><Cell ss:MergeAcross="2"><Data ss:Type="String">payment_history</Data></Cell></Row>
   <Row ss:StyleID="Th"><Cell><Data ss:Type="String">Поле</Data></Cell><Cell><Data ss:Type="String">Тип</Data></Cell><Cell><Data ss:Type="String">Опис</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">id</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">PK</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">order_id</Data></Cell><Cell><Data ss:Type="String">INT</Data></Cell><Cell><Data ss:Type="String">FK, посилання на orders.id</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">amount</Data></Cell><Cell><Data ss:Type="String">DECIMAL(18,2)</Data></Cell><Cell><Data ss:Type="String">Сума платежу</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">card_last4</Data></Cell><Cell><Data ss:Type="String">VARCHAR(8)</Data></Cell><Cell><Data ss:Type="String">Останні цифри картки</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">created_at</Data></Cell><Cell><Data ss:Type="String">TIMESTAMPTZ</Data></Cell><Cell><Data ss:Type="String">Час проведення</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">content_type</Data></Cell><Cell><Data ss:Type="String">VARCHAR(100)</Data></Cell><Cell><Data ss:Type="String">Тип файлу квитанції</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">receipt_pdf</Data></Cell><Cell><Data ss:Type="String">BLOB</Data></Cell><Cell><Data ss:Type="String">Файл квитанції (PDF)</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">operator_id</Data></Cell><Cell><Data ss:Type="String">INT, NULL</Data></Cell><Cell><Data ss:Type="String">FK, посилання на keys.id (оператор)</Data></Cell></Row>
  </Table>
 </Worksheet>
</Workbook>
